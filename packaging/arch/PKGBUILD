# Maintainer: TermGlass contributors
# Packages the already-built app (run `npx electron-builder --linux dir` first, see packaging/arch/build.sh).
pkgname=termglass
# Always matches package.json, so a tagged release builds the matching package.
pkgver=$(node -p "require('$startdir/../../package.json').version")
pkgrel=5
pkgdesc='Minimal, glass-inspired terminal emulator (Electron, xterm.js, node-pty)'
arch=('x86_64')
url='https://github.com/NettixDev-ctrl/TermGlass'
license=('MIT')
depends=('gtk3' 'nss' 'alsa-lib' 'libxss' 'libxtst' 'xdg-utils')
# Electron ships prebuilt binaries; stripping them breaks the app.
options=('!strip' '!debug')

package() {
  local app="$startdir/../../release/linux-unpacked"
  local root="$startdir/../.."

  install -d "$pkgdir/opt/termglass"
  cp -r --no-preserve=ownership "$app/." "$pkgdir/opt/termglass/"
  # Chromium's setuid sandbox helper, as in Arch's electron packages.
  chmod 4755 "$pkgdir/opt/termglass/chrome-sandbox"

  install -d "$pkgdir/usr/bin"
  ln -s /opt/termglass/termglass "$pkgdir/usr/bin/termglass"

  install -Dm644 "$root/build/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/termglass.png"
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/termglass.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=TermGlass
Comment=Minimal glass-inspired terminal emulator
Exec=/usr/bin/termglass
Icon=termglass
Terminal=false
Categories=System;TerminalEmulator;
Keywords=terminal;shell;console;command;
StartupWMClass=termglass
DESKTOP
}
