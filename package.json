{
  "name": "termglass",
  "productName": "TermGlass",
  "version": "0.1.0",
  "description": "A minimal, glass-inspired, cross-platform terminal emulator built with Electron, xterm.js and node-pty.",
  "homepage": "https://github.com/NettixDev-ctrl/TermGlass",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NettixDev-ctrl/TermGlass.git"
  },
  "bugs": {
    "url": "https://github.com/NettixDev-ctrl/TermGlass/issues"
  },
  "keywords": [
    "terminal",
    "terminal-emulator",
    "electron",
    "xterm",
    "node-pty",
    "wayland",
    "kde"
  ],
  "author": "TermGlass contributors",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:main",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "test:unit": "node scripts/unit-tests.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/shells.mjs",
    "test": "npm run typecheck && npm run test:unit",
    "test:e2e:shells": "node tests/e2e/shells.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
